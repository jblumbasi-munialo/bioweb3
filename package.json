{
  "name": "bioweb3",
  "version": "2.0.0",
  "description": "BioWeb3: Integrated bioinformatics platform with blockchain",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development --env NODE_ENV=development",
    "build": "webpack --mode production --env NODE_ENV=production",
    "build:dev": "webpack --mode development --env NODE_ENV=development",
    "build:staging": "webpack --mode production --env NODE_ENV=production --env REACT_APP_ENVIRONMENT=staging",
    "analyze": "webpack-bundle-analyzer dist/core/stats.json dist/features/stats.json",
    "serve": "http-server dist -p 8080 -c-1",
    "clean": "rimraf dist",
    "lint": "eslint js/ --ext .js",
    "format": "prettier --write \"js/**/*.js\""
  },
  "keywords": [
    "bioinformatics",
    "blockchain",
    "web3",
    "biotech"
  ],
  "author": "BioWeb3 Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.23.0",
    "@babel/runtime": "^7.29.7",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "eslint": "^8.50.0",
    "http-server": "^14.1.0",
    "mini-css-extract-plugin": "^2.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "style-loader": "^3.3.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "web3": "^4.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
