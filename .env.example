# BioWeb3 Environment Configuration
# Copy to .env.local for local overrides (git-ignored)

# Environment: development, staging, production
REACT_APP_ENVIRONMENT=development

# API Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_SOCKET_URL=ws://localhost:3000

# Feature Flags (optional overrides)
REACT_APP_ENABLE_HEALTHCARE50=true
REACT_APP_ENABLE_RESEARCH_AGG=true
REACT_APP_ENABLE_DEV_TOOLS=true

# Third-party API Keys (never commit real keys!)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON=your-anon-key-here
REACT_APP_GROQ_API_KEY=your-groq-key-here

# Analytics
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_GA_ID=UA-XXXXXXXXX-X

# PWA
REACT_APP_PWA_ENABLED=true
REACT_APP_SERVICE_WORKER_ENABLED=true

# Performance
REACT_APP_ENABLE_SOURCEMAPS=true
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_VERSION=v1
